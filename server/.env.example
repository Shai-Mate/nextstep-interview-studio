# Keep secrets on the service host. Never prefix secrets with VITE_.
HOST=127.0.0.1
PORT=8787
NODE_ENV=production

# Optional online coaching. Local app features do not need these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional public professional company/interviewer research using OpenAI web search.
# Requires a model supporting both web_search and structured Responses output.
# Clients must obtain separate webResearch:true permission for each request.
PRISM_ENABLE_WEB_RESEARCH=false

# Required to enable online coaching in production; inject at a trusted gateway,
# not into a public client bundle. Do not ship a shared service token in the app.
PRISM_SERVICE_TOKEN=

# Exact permitted browser origins, comma separated; no wildcard or trailing slash.
PRISM_ALLOWED_ORIGINS=https://your-real-app-domain.example
PRISM_OPERATOR_NAME=
PRISM_PRIVACY_URL=
PRISM_SUPPORT_EMAIL=
PRISM_SUPPORT_URL=

# Only enable when the environment's egress proxy independently blocks access to
# private/internal networks. Direct mode pins validated public DNS addresses.
PRISM_TRUST_ENV_PROXY=0

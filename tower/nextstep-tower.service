[Unit]
Description=NextStep course writer (Codex on this tower)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/nextstep-tower.env
WorkingDirectory=%h/nextstep-interview-studio
ExecStart=/usr/bin/node %h/nextstep-interview-studio/tower/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

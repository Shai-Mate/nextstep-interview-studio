# Copy to deploy/.env and replace the example domain with a hostname you own.
# The file is ignored by Git and Docker build context. Never put secrets in VITE_*.
MOMENTUM_DOMAIN=careers.your-domain.example
PRISM_ALLOWED_ORIGINS=https://careers.your-domain.example
PRISM_OPERATOR_NAME=
PRISM_PRIVACY_URL=https://careers.your-domain.example/privacy.html
PRISM_SUPPORT_EMAIL=
PRISM_SUPPORT_URL=

# Leave AI disabled for the default public deployment. A private authenticated
# gateway and explicit user consent are prerequisites for enabling paid calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PRISM_SERVICE_TOKEN=
PRISM_ENABLE_WEB_RESEARCH=false
PRISM_TRUST_ENV_PROXY=0
